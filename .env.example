# Copy to .env to override docker-compose defaults. Never commit a real .env.
# Docker Compose is for local development only; the target deployment is GKE.

# --- Mode ------------------------------------------------------------------------
# GCP, Terraform and the VMs are simulated (no cloud resources, no credentials).
# MOCK_MODE=false is refused until per-organization identities exist (docs/adr/0003).
MOCK_MODE=true
# Multiplier for simulated durations (0.5 = twice as fast).
MOCK_SPEED=1.0

# --- Secrets -------------------------------------------------------------------------
# Required (at least 32 random characters) when ENVIRONMENT=production:
#   openssl rand -base64 48
SECRET_KEY=
POSTGRES_PASSWORD=byoc-local-dev

# --- Elasticsearch --------------------------------------------------------------------
# Exact version for new clusters; must be a "supported" entry of
# backend/app/providers/database/elasticsearch/versions.yaml. Empty = the catalog default.
ELASTICSEARCH_VERSION=

# --- Demo data (mock mode) --------------------------------------------------------------
SEED_DEMO_DATA=true
DEMO_PASSWORD=demo-password

# --- Agents --------------------------------------------------------------------------
# HTTPS URL the node agents use to reach this control plane. Leave empty when the control
# plane is not reachable from the VMs: agents then report through GCE guest attributes,
# which the control plane reads via the Compute API.
CONTROL_PLANE_PUBLIC_URL=
# Set to true when the UI is served over HTTPS.
COOKIE_SECURE=false

# --- Ports ---------------------------------------------------------------------------
UI_PORT=3000
API_PORT=8000
